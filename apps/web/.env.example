# Copia este archivo como .env. Estas variables son públicas: nunca pongas secretos aquí.
# Dirección de la API
VITE_API_URL=http://localhost:3001
# Id de un certificado de demostración real, para el enlace "Ver cómo se verifica un certificado" del inicio.
# Si queda vacío, el enlace no se muestra.
VITE_DEMO_CERTIFICATE_ID=
# Clave publicable de Clerk para el ingreso del emisor (es pública, no es un secreto)
VITE_CLERK_PUBLISHABLE_KEY=
