# Copia este archivo como .env y completa los valores. No lo subas al repositorio.
NODE_ENV=development
PORT=3001

# Cadena de conexión a PostgreSQL. En local, usa los valores del .env de la raíz.
# Formato: postgres://USUARIO:CONTRASEÑA@localhost:5432/NOMBRE_BD
DATABASE_URL=
# true cuando la base de datos exige SSL (por ejemplo en staging)
DATABASE_SSL=false

# Origen permitido para la interfaz, separado por comas si son varios
CORS_ORIGIN=http://localhost:5173

# Clerk (autenticación). En producción CLERK_SECRET_KEY y CLERK_PUBLISHABLE_KEY son obligatorias.
# Llaves del panel de Clerk (API Keys). La llave secreta nunca se sube al repositorio.
CLERK_SECRET_KEY=
CLERK_PUBLISHABLE_KEY=
# Opcional: llave pública JWT de Clerk. Con ella el token se verifica sin red.
CLERK_JWT_KEY=
