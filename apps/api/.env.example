# Copia este archivo como .env y completa los valores. No lo subas al repositorio.
NODE_ENV=development
PORT=3001

# Cadena de conexión a PostgreSQL. En local, usa los valores del .env de la raíz.
# Formato: postgres://USUARIO:CONTRASEÑA@localhost:5432/NOMBRE_BD
DATABASE_URL=
# true cuando la base de datos exige SSL (por ejemplo en staging)
DATABASE_SSL=false

# Origen permitido para la interfaz, separado por comas si son varios
CORS_ORIGIN=http://localhost:5173

# Clerk (autenticación). CLERK_SECRET_KEY, CLERK_PUBLISHABLE_KEY y CORS_ORIGIN son obligatorias
# solo cuando NODE_ENV=production.
# Llaves del panel de Clerk (API Keys). La llave secreta nunca se sube al repositorio.
CLERK_SECRET_KEY=
CLERK_PUBLISHABLE_KEY=
# Opcional: llave pública JWT de Clerk (PEM, BEGIN PUBLIC KEY). Con ella el token se verifica sin red.
# Conserva los saltos de línea (ponla entre comillas) o ponla toda en una sola línea.
CLERK_JWT_KEY=

# Registro de certificados: usa postgres por defecto o stellar para la red.
# Con postgres no se necesitan las variables de Stellar. Con stellar, son obligatorias todas las de abajo.
REGISTRY_DRIVER=postgres
# URL del RPC de Stellar cuando REGISTRY_DRIVER=stellar.
STELLAR_RPC_URL=
# Frase de red de Stellar cuando REGISTRY_DRIVER=stellar.
STELLAR_NETWORK_PASSPHRASE=
# ID del contrato de registro cuando REGISTRY_DRIVER=stellar.
STELLAR_CONTRACT_ID=
# Secreto maestro para derivar las cuentas de emisores cuando REGISTRY_DRIVER=stellar.
STELLAR_MASTER_SECRET=
# Secreto de la cuenta administradora cuando REGISTRY_DRIVER=stellar.
STELLAR_ADMIN_SECRET=
# Secreto de la cuenta patrocinadora cuando REGISTRY_DRIVER=stellar.
STELLAR_SPONSOR_SECRET=

# Custodia del MVP: HabilitApp firma por cada emisor (custodia delegada). Una llave maestra deriva
# la cuenta de cada emisor; la llave del administrador y la de la cuenta patrocinadora son distintas.
# Ningún secreto se versiona ni se escribe en logs. No hay rotación de la llave maestra en el MVP:
# cambiarla produciría otras cuentas y rompería la asociación con los certificados existentes.
#
# Límites aceptados: si la red confirma un certificado y PostgreSQL falla, puede quedar una huella
# huérfana; si la red autoriza un emisor y luego falla Clerk o el commit, puede quedar una cuenta
# autorizada sin fila local. Si la red anula o revoca y PostgreSQL falla, la red queda adelantada
# y el reintento corrige la base.
# No hay proceso de limpieza ni renovación programada de TTL; cada escritura renueva cerca de seis
# meses en testnet. La renovación periódica, HSM, multifirma y firma directa del emisor quedan para después.
